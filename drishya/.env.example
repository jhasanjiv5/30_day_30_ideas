# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Drishya Pipeline Mode & Storage
DRISHYA_MOCK_MODE=true
DRISHYA_RETENTION_DAYS=30
DRISHYA_STORAGE_DIR=./data/storage
DRISHYA_SESSION_SECRET=

# Optional Real Provider Credentials (Server-side only)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
CLOUD_TTS_PROVIDER=mock
PIPER_BIN_PATH=piper
SEARCH_API_KEY=

# Docker / FastAPI / Postgres / Redis / MinIO Stack
DATABASE_URL=postgresql+psycopg://drishya:drishya@postgres:5432/drishya
REDIS_URL=redis://redis:6379/0
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=drishya-artifacts
