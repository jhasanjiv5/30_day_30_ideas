# Prod Preview Configuration (all secrets stay server-side)
# Replace placeholder values below with real credentials when connecting live GCP or LLM APIs.
PORT="3000"
APP_URL="http://localhost:3000"
ENVIRONMENT_PROVIDER="mock" # mock | gcp
DATABASE_URL="postgresql://prodpreview:prodpreview@postgres:5432/prodpreview"

# Security Secrets (run `make keys` to generate 32-byte random secrets locally, or inject via Secret Manager)
SESSION_TOKEN_SECRET="YOUR_SESSION_TOKEN_SECRET_32_BYTES"
INVITE_TOKEN_SECRET="YOUR_INVITE_TOKEN_SECRET_32_BYTES"
BYOK_ENCRYPTION_KEY="YOUR_BYOK_ENCRYPTION_KEY_32_BYTES"

# Google Sign-In / GCP Project (optional in mock mode)
GOOGLE_IDENTITY_CLIENT_ID="YOUR_GOOGLE_IDENTITY_CLIENT_ID.apps.googleusercontent.com"
GCP_PROJECT_ID="YOUR_GCP_POC_PROJECT_ID"
GCP_ACCESS_TOKEN="YOUR_OPTIONAL_GCP_ACCESS_TOKEN"

# LLM Provider Selection & API Key Placeholders (configured via config/llm_providers.yaml + env)
DEFAULT_LLM_PROVIDER="vertex_gemini" # none | vertex_gemini | vertex_claude | anthropic | openai | azure_openai | openai_compatible
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
VERTEX_PROJECT_ID="YOUR_VERTEX_GCP_PROJECT_ID"
VERTEX_LOCATION="europe-west1"
VERTEX_GEMINI_MODEL="gemini-4-hydrogen"
VERTEX_CLAUDE_MODEL="claude-sonnet-4-5@vertex"
ANTHROPIC_API_KEY="YOUR_ANTHROPIC_API_KEY"
ANTHROPIC_MODEL="claude-3-7-sonnet-latest"
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"
OPENAI_MODEL="gpt-4.1-mini"
AZURE_OPENAI_API_KEY="YOUR_AZURE_OPENAI_API_KEY"
AZURE_OPENAI_ENDPOINT="https://YOUR_RESOURCE.openai.azure.com"
AZURE_OPENAI_DEPLOYMENT="gpt-4.1"
OPENAI_COMPAT_BASE_URL="http://localhost:11434/v1"
OPENAI_COMPAT_API_KEY="YOUR_OPENAI_COMPAT_API_KEY"
OPENAI_COMPAT_MODEL="llama3.1:8b"
