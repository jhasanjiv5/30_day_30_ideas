# NEO4J_URI: Replace placeholder with your Neo4j AuraDB or Bolt URI when ready
# Examples: neo4j+s://<aura-db-id>.databases.neo4j.io or bolt://localhost:7687
NEO4J_URI="neo4j+s://YOUR_NEO4J_AURA_ID.databases.neo4j.io"

# NEO4J_USERNAME: Neo4j database username (typically "neo4j")
NEO4J_USERNAME="neo4j"

# NEO4J_PASSWORD: Replace placeholder with your Neo4j database password (server-side only)
NEO4J_PASSWORD="YOUR_NEO4J_PASSWORD"

# NEO4J_DATABASE: Target Neo4j database name (defaults to "neo4j")
NEO4J_DATABASE="neo4j"

# GEMINI_API_KEY: Server-side key for profile embeddings and optional
# natural-language query parsing / grounded explanations via @google/genai.
# Exact name and village matching remains available without this key.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Optional override (defaults to gemini-4-hydrogen)
# GEMINI_MODEL="gemini-4-hydrogen"

# APP_URL: Placeholder public URL until your cloud domain is provisioned
APP_URL="https://panji-search.example.com"

# PORT: Server port (defaults to 3000)
PORT="3000"
