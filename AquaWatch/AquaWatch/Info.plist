<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key>
    <string>AquaWatch</string>
    <key>CFBundleIdentifier</key>
    <string>com.aquawatch.watchkitapp</string>
    <key>CFBundleName</key>
    <string>AquaWatch</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>WKApplication</key>
    <true/>
    <key>WKWatchOnly</key>
    <true/>
    
    <!-- Motion & Gyroscope Privacy Usage Description -->
    <key>NSMotionUsageDescription</key>
    <string>AquaWatch analyzes wrist gyroscopic movements to automatically detect when you take a sip of water.</string>
    
    <!-- Apple HealthKit Privacy Descriptions -->
    <key>NSHealthShareUsageDescription</key>
    <string>AquaWatch reads your hydration and workout data to calculate personalized water targets.</string>
    <key>NSHealthUpdateUsageDescription</key>
    <string>AquaWatch automatically writes your verified drinking activities to Apple Health.</string>
</dict>
</plist>